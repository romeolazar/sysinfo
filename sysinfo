title_row "  SYSTEM OVERVIEW"

section "Identity"
kv_row "Host"    "$(whoami)@$(hostname)"
kv_row "OS"      "$OS_NAME"
# CPU model — truncate to fit VL
# Truncate CPU model to fit, keeping "(X cores)" suffix intact
_cores_suffix=" (${CPU_CORES} cores)"
_model_max=$(( VL - ${#_cores_suffix} - 1 ))
if [ "${#CPU_MODEL}" -gt "$_model_max" ]; then
  cpu_display="${CPU_MODEL:0:$(( _model_max - 1 ))}~${_cores_suffix}"
else
  cpu_display="${CPU_MODEL}${_cores_suffix}"
fi
kv_row "CPU" "$cpu_display"
for _i in "${!LOCAL_IPS[@]}"; do
  if [ "$_i" -eq 0 ]; then kv_row "Local IPs" "${LOCAL_IPS[$_i]}" "$CYAN" "$GREEN"
  else                       kv_row ""          "${LOCAL_IPS[$_i]}" "$CYAN" "$GREEN"
  fi
done
kv_row "Public IP"  "$PUBLIC_IP"   "$CYAN" "$MAGENTA"
kv_row "Uptime"     "$UPTIME_STR"  "$CYAN" "$UPTIME_COLOR"
kv_row "Last Login" "$LAST_LOGIN"  "$CYAN" "$DIM"

section "System Resources"
res_row "CPU"    "$CPU_PCT" "$CPU_FRAC"
res_row "Memory" "$MEM_PCT" "$MEM_FRAC"

section "Top 5 CPU Processes"
for i in "${!PROC_NAME[@]}"; do
  proc_row "${PROC_NAME[$i]}" "${PROC_PID[$i]}" "${PROC_CPU[$i]}" "${PROC_MEM[$i]}"
done

section "Storage"
if [ "${#MKEYS[@]}" -eq 0 ]; then
  kv_row "No mounts found" "" "$RED"
else
  for i in "${!MKEYS[@]}"; do
    res_row "${MKEYS[$i]}" "${MPCT[$i]}" "${MFRAC[$i]}"
  done
fi

section "Drives"
if [ "${#DRV_DEV[@]}" -eq 0 ]; then
  kv_row "No drives found" "" "$RED"
else
  drive_header
  for i in "${!DRV_DEV[@]}"; do
    drive_row "${DRV_DEV[$i]}" "${DRV_MODEL[$i]}" "${DRV_SIZE[$i]}" "${DRV_TEMP[$i]}" "${DRV_STATUS[$i]}"
  done
  [ "$HAS_SMARTCTL" -eq 0 ] && kv_row "⚠ install smartctl" "dnf install smartmontools" "$YELLOW" "$DIM"
fi

if [ "${#RAID_DEV[@]}" -gt 0 ]; then
  section "RAID Health"
  for i in "${!RAID_DEV[@]}"; do
    case "${RAID_DETAIL[$i]}" in
      clean|active)          sc="$GREEN"  ;;
      degraded*|recovering*) sc="$YELLOW" ;;
      *)                     sc="$RED"    ;;
    esac
    kv_row "/dev/${RAID_DEV[$i]}" "${RAID_STATE[$i]}" "$CYAN" "$sc"
  done
fi

if [ "${#HW_NAME[@]}" -gt 0 ]; then
  section "Hardware Health"
  for i in "${!HW_NAME[@]}"; do
    case "${HW_TYPE[$i]}" in
      temp)
        temp_num=$(echo "${HW_VALUE[$i]}" | grep -oE '^[0-9]+')
        tint=${temp_num:-0}
        # Override status based on actual temperature value
        if   [ "$tint" -ge 90 ]; then _tstatus="CRITICAL"; _tcolor="$RED"
        elif [ "$tint" -ge 75 ]; then _tstatus="WARNING";  _tcolor="$YELLOW"
        else                          _tstatus="ok";        _tcolor="$GREEN"
        fi
        hw_row "${HW_NAME[$i]}" "${HW_VALUE[$i]}" "$_tstatus" "$_tcolor" "temp"
        ;;
      fan)
        hw_row "${HW_NAME[$i]}" "${HW_VALUE[$i]}" "${HW_STATUS[$i]}" "$BLUE" "fan"
        ;;
    esac
  done
